# Sunucu (docker compose) ayarları — bu dosyayı sunucuda .env adıyla kopyalayıp doldurun.
#   cp .env.production.example .env

# Sitenin genel adresi (HTTPS, sonda / olmadan). Değiştirirseniz imajı yeniden derleyin: docker compose up -d --build
SITE_URL=https://ch5.chainasc.com
# Uygulamanın sunucuda dinleyeceği yerel port (ters vekil buraya yönlendirir). 5080 portal tarafından kullanılıyor.
WEB_PORT=5081
TZ=Europe/Istanbul

# En az 32 karakterlik rastgele değerler:  openssl rand -hex 32
# DİKKAT: Yerelden içerik aktarılacaksa PAYLOAD_SECRET yereldeki .env ile AYNI olmalı;
# aksi hâlde panelde kayıtlı e-posta şifreleri çözülemez ve panelden yeniden girilmesi gerekir.
PAYLOAD_SECRET=
POSTGRES_PASSWORD=

# Panelden yüklenebilecek en büyük dosya (MB). Nginx'te client_max_body_size en az bu kadar olmalı.
MAX_UPLOAD_MB=300

# Varsayılan SMTP (isteğe bağlı) — e-posta gönderimi normalde panelden ayarlanır.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
