# Veritabanı (docker-compose.dev.yml ile uyumlu)
DATABASE_URL=postgres://galvano:galvano_dev@127.0.0.1:5433/galvano
# En az 32 karakterlik rastgele bir değer kullanın.
# DİKKAT: Panelde kayıtlı e-posta şifreleri bu anahtarla şifrelenir; değiştirilirse panelden yeniden girilmeleri gerekir.
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Varsayılan SMTP — yalnızca panelde (Ayarlar → E-posta Gönderimi) "Sunucu varsayılanı" seçiliyken kullanılır.
# Yerelde Mailpit: http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=web@galvanokimya.com

# Seed (yalnızca ilk kurulum)
SEED_ADMIN_EMAIL=admin@galvanokimya.local
SEED_ADMIN_PASSWORD=
SEED_QUOTE_EMAIL=teklif@galvanokimya.com

# Panelden yüklenebilecek en büyük dosya (MB) — drone videoları için
MAX_UPLOAD_MB=300
