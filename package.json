{
  "name": "galvano-web",
  "version": "1.0.0",
  "description": "Galvano Kimya kurumsal web sitesi (Payload CMS + Next.js)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "contact:apply": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/apply-contact.ts",
    "about:apply": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/apply-about.ts",
    "media:real": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/real-photos.ts",
    "media:stock": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/stock-photos.ts",
    "brand:apply": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/apply-brand.ts",
    "privacy:apply": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/apply-privacy.ts",
    "catalog:apply": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/apply-catalog.ts",
    "partners:apply": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/apply-partners.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "^3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "^3.90.2",
    "@payloadcms/ui": "3.90.2",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "d3-geo": "^3.1.1",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "16.3.3",
    "nodemailer": "^9.1.1",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "postcss": "^8.5.30",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.18.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
